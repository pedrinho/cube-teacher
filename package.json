{
  "name": "cube",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/teacher",
    "dev:hero": "npm run dev -w apps/hero",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "site": "rm -rf site && cp -R apps/teacher/dist site && cp -R apps/hero/dist site/hero"
  }
}
